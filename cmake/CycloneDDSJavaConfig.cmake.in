@PACKAGE_INIT@
set(_CycloneDDSJava_PREFIX "${PACKAGE_PREFIX_DIR}")
include(CMakeFindDependencyMacro)
find_dependency(CycloneDDS @PROJECT_VERSION@ EXACT)
find_dependency(Java 17 COMPONENTS Development)
include("${CMAKE_CURRENT_LIST_DIR}/CycloneDDSJavaTargets.cmake")
set(CycloneDDSJava_RUNTIME_JAR "${_CycloneDDSJava_PREFIX}/share/java/org.eclipse.cyclonedds.jar")
set(CycloneDDSJava_BUNDLED_RUNTIME_JAR "${_CycloneDDSJava_PREFIX}/share/java/@UNIVERSAL_RUNTIME_NAME@")
set(CycloneDDSJava_IDLC_JAR "${_CycloneDDSJava_PREFIX}/share/java/@UNIVERSAL_IDLC_NAME@")
set(CycloneDDSJava_API_JAR "${_CycloneDDSJava_PREFIX}/share/java/omg-dds-api.jar")
set(CycloneDDSJava_IDL_API_JAR "${_CycloneDDSJava_PREFIX}/share/java/idl4-java-api.jar")
include("${CMAKE_CURRENT_LIST_DIR}/IdlJavaGenerate.cmake")
