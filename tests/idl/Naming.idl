module Naming {
 @final struct Base {long number;};
 @final struct Derived : Base {long parent;};
 @final struct java {string org; string text; long typeSupport; long get_foo; long foo; long hashCode; long CODEC; long TYPE;};
 @final struct RuntimePrefixes {string java; string org; long codec;};
};
module QosEvolution {
  @appendable struct Original { @id(0) long value; };
  @appendable struct Extended { @id(0) long value; @id(1) long extra; };
};
